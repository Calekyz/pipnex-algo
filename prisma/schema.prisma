generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================
model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  name          String?
  status        String   @default("PENDING")
  credits       Int      @default(0)
  plan          String?
  planExpiry    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  licenses      UserLicense[]
  payments      PaymentProof[]
  supportTickets SupportTicket[]
  bots          Bot[]
  brokerAccounts BrokerAccount[]
  eaInstances   EAInstance[]
}

// ============================================
// LICENSE SYSTEM
// ============================================
model UserLicense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  code          String   @unique
  plan          String
  duration      Int
  expiresAt     DateTime
  redeemedAt    DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model LicenseCode {
  id            String   @id @default(cuid())
  code          String   @unique
  plan          String
  duration      Int
  isUsed        Boolean  @default(false)
  usedBy        String?
  usedAt        DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?
}

// ============================================
// PAYMENT SYSTEM
// ============================================
model PaymentProof {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  method        String
  amount        Int
  requestedPlan String?
  reference     String?
  screenshotUrl String?
  status        String   @default("SUBMITTED")
  verifiedBy    String?
  createdAt     DateTime @default(now())
  verifiedAt    DateTime?
}

// ============================================
// SUPPORT SYSTEM
// ============================================
model SupportTicket {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  subject       String
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      SupportMessage[]
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id])
  sender        String
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ============================================
// BOTS SYSTEM
// ============================================
model Bot {
  id            String   @id @default(cuid())
  name          String
  description   String
  type          String
  strategy      String
  riskLevel     String
  performance   String
  icon          String   @default("🤖")
  color         String   @default("blue")
  isActive      Boolean  @default(true)
  isRunning     Boolean  @default(false)
  isArchived    Boolean  @default(false)
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id])
  eaInstances   EAInstance[]
}

// ============================================
// BROKER ACCOUNTS
// ============================================
model BrokerAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  name          String
  broker        String
  accountId     String
  password      String
  server        String?
  apiToken      String?
  apiHost       String?
  
  isConnected   Boolean  @default(false)
  lastConnected DateTime?
  status        String   @default("INACTIVE")
  
  enabled       Boolean  @default(true)
  maxLotSize    Float?
  riskPerTrade  Float?
  
  totalTrades   Int      @default(0)
  totalProfit   Float    @default(0)
  winRate       Float    @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eaInstances   EAInstance[]

  @@unique([userId, accountId, broker])
}

// ============================================
// EA INSTANCES
// ============================================
model EAInstance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  brokerAccountId String
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id])
  
  botId         String
  bot           Bot      @relation(fields: [botId], references: [id])
  
  status        String   @default("REGISTERED")
  startedAt     DateTime?
  stoppedAt     DateTime?
  
  balance       Float    @default(0)
  equity        Float    @default(0)
  openPositions Int      @default(0)
  totalTrades   Int      @default(0)
  profit        Float    @default(0)
  
  config        Json?
  
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// EA ANALYTICS (NEW)
// ============================================
model EAAnalytics {
  id              String   @id @default(cuid())
  clientId        String   @unique
  accountType     String?  // "Live" or "Demo"
  balance         Float    @default(0)
  equity          Float    @default(0)
  profit          Float    @default(0)
  openPositions   Int      @default(0)
  totalTrades     Int      @default(0)
  winningTrades   Int      @default(0)
  losingTrades    Int      @default(0)
  winRate         Float    @default(0)
  sequencesCompleted Int  @default(0)
  currentSequence   Int   @default(0)
  tradesInSequence Int   @default(0)
  tradesPerSequence Int  @default(0)
  inRecoveryMode  Boolean  @default(false)
  currentLot      Float    @default(0)
  drawdown        Float    @default(0)
  dailyLoss       Float    @default(0)
  gridActive      Boolean  @default(false)
  gridAdditions   Int      @default(0)
  maxGridAdditions Int    @default(0)
  positions       Json?    // Array of open positions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
