generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String          @id @default(cuid())
  clerkId       String          @unique
  email         String          @unique
  name          String?
  status        UserStatus      @default(PENDING)
  credits       Int             @default(0)
  plan          String?         // "PRO", "GOLD", "PLATINUM"
  planExpiry    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  licenses      UserLicense[]
  payments      PaymentProof[]  // For pipnex-algo1 (optional)
  supportTickets SupportTicket[]
}

// ============================================
// LICENSE SYSTEM (for pipnex-algo)
// ============================================

model UserLicense {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  code          String          @unique
  plan          String          // "PRO", "GOLD", "PLATINUM"
  duration      Int             // Duration in days
  expiresAt     DateTime
  redeemedAt    DateTime        @default(now())
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
}

model LicenseCode {
  id            String          @id @default(cuid())
  code          String          @unique
  plan          String          // "PRO", "GOLD", "PLATINUM"
  duration      Int             // Duration in days
  isUsed        Boolean         @default(false)
  usedBy        String?
  usedAt        DateTime?
  createdBy     String?
  createdAt     DateTime        @default(now())
  expiresAt     DateTime?
}

// ============================================
// PAYMENT SYSTEM (for pipnex-algo1)
// ============================================

model PaymentProof {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  method        String       // "MPESA" or "CRYPTO"
  amount        Int          // Amount in KES or USD
  requestedPlan String?      // "PRO", "GOLD", "PLATINUM"
  reference     String?      // M-Pesa Code or TX Hash
  screenshotUrl String?      // URL to uploaded image
  status        ProofStatus  @default(SUBMITTED)
  verifiedBy    String?      // Admin email
  createdAt     DateTime     @default(now())
  verifiedAt    DateTime?
}

// ============================================
// SUPPORT SYSTEM
// ============================================

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages  SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  sender     SenderType
  message    String
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  PENDING
  PENDING_VERIFICATION   // For pipnex-algo1
  ACTIVE
  EXPIRED
}

enum ProofStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum SenderType {
  USER
  ADMIN
}
